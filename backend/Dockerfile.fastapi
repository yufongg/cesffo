# Use an official Python runtime as a parent image
FROM python:3.13-slim-trixie

RUN apt-get update 
RUN apt-get install -y gcc libpq-dev python3.13-dev

RUN python3 -m venv /opt/venv
ENV PATH="/venv/bin:$PATH"


# Set the working directory in the container
WORKDIR /app
# The actual mounting of the host's "project" folder will be done via Docker Compose

# Copy requirements.txt from mounted directory to /app
COPY ./requirements.txt /app

# Install any needed packages specified in requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy the current directory contents into the container at /app
COPY . /app/

# Create the writable upload mountpoint before /app is mounted read-only
RUN mkdir -p /app/uploads/forum

# Make port 5000 available to the world outside this container
EXPOSE 5000

# Run app.py when the container launches
CMD ["python", "main.py"]
