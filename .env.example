# .env.example — copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SECRET=


APP_ENV=development

# REQUIRED in production (the app refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Master secret used to derive the AES-256-GCM key that encrypts PII (email,
# future fields). REQUIRED in production (app refuses to start without it).
# Rotating this makes existing ciphertext undecryptable. Generate 32 bytes with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# Comma-separated browser origins allowed to call the API, e.g.
#   https://app.example.com,https://www.example.com
# Leave blank in development to use the built-in localhost defaults. Do NOT use "*".
CORS_ALLOWED_ORIGINS=
